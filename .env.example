# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/emr

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-long-random-secret-never-commit-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Sarvam AI ---
# Get this from https://dashboard.sarvam.ai -> API Keys -> Create New Key
SARVAM_API_KEY=your-sarvam-subscription-key-here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3

# --- OpenAI LLM for note structuring + clinical entity extraction ---
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=medium

# --- Redis / Celery (async job queue for scale) ---
# Celery requires Upstash's native TLS Redis URL, not its REST URL/token.
REDIS_URL=rediss://default:replace-me@your-database.upstash.io:6379/0?ssl_cert_reqs=required

# --- Backblaze B2 private audio bucket ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=emr-records
# Optional: automatically discovered when empty.
B2_S3_ENDPOINT=
B2_PRESIGN_EXPIRE_SECONDS=900
VOICE_UPLOAD_MAX_BYTES=104857600

# --- Administration application / invitation delivery ---
FRONTEND_URL=http://localhost:3000
DOCTOR_FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
INVITATION_EXPIRE_HOURS=48
# Leave SMTP_HOST empty in local development; invitation links are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@meridianhealth.ai
SMTP_USE_TLS=true

# --- App ---
ENVIRONMENT=development
